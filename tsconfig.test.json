{
  // Type-checks test files and hand-written JavaScript. Run through scripts/type-ratchet.mjs, which
  // counts each distinct error per file against .type-ratchet-baseline.json (counts may only fall).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // JavaScript is checked too: a fixture or mock that drifted from production is a type error
    // there just as in .ts, and so is a JS caller passing what a TS signature rejects.
    "checkJs": true,
    // An untyped callback parameter or an unused import is not drift; the shapes the test
    // passes to production are.
    "noImplicitAny": false,
    "noUnusedLocals": false,
    // Tests run in Node, not the app's WebView, so `.at()` and `isWellFormed()` exist there.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "dist", "build", "wasm-core/target", "scripts", "src/wasm"]
}
