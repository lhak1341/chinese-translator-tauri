{
  "_contract": "Chunker fixture (architecture review 2026-10-03, candidate #3 grilling; the Rust twin was deleted 2026-10-06, ADR-079). src/utils/__tests__/TextChunker.parity.test.js asserts TextChunker.js against `expected`. Do not edit an expectation to make a test pass: change the chunker, or record the behaviour on purpose. startIndex of a chunk whose content is empty (a punctuation-only or line-break-only chunk) is unspecified and nothing reads it (the engine's chunkStartChar only reaches chunks with Chinese content), so it is null here and the harness skips it. A chunk WITH content must match, and startIndex indexes its trimmed content: input.slice(startIndex, startIndex + content.length) === content, so leading whitespace (an indent) is skipped.",
  "cases": [
    {
      "name": "comma_and_period_agree",
      "description": "Ordinary Chinese sentence punctuation splits on both sides.",
      "input": "你好，世界。",
      "expected": [
        {
          "content": "你好",
          "punctuation": "，",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "世界",
          "punctuation": "。",
          "startIndex": 3,
          "lineBreaks": "",
          "startedBy": "，"
        }
      ]
    },
    {
      "name": "stacked_quote_punctuation_agree",
      "description": "Consecutive punctuation merges onto the preceding chunk.",
      "input": "他说：「好」",
      "expected": [
        {
          "content": "他说",
          "punctuation": "：「",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "」",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "：「"
        }
      ]
    },
    {
      "name": "hyphen_agree",
      "description": "Pd (dash punctuation): Both sides split on it (the JS detector enabled Pd and Pc on 2026-10-03 to match Rust, which is what ships).",
      "input": "他说-好",
      "expected": [
        {
          "content": "他说",
          "punctuation": "-",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 3,
          "lineBreaks": "",
          "startedBy": "-"
        }
      ]
    },
    {
      "name": "em_dash_pair_agree",
      "description": "The Chinese two-em dash (——) used for breaks in dialogue; Pd, so the same as the hyphen.",
      "input": "他说——好",
      "expected": [
        {
          "content": "他说",
          "punctuation": "——",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "——"
        }
      ]
    },
    {
      "name": "underscore_agree",
      "description": "Pc (connector punctuation): Both sides split on it (the JS detector enabled Pc on 2026-10-03 to match Rust).",
      "input": "他_好",
      "expected": [
        {
          "content": "他",
          "punctuation": "_",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 2,
          "lineBreaks": "",
          "startedBy": "_"
        }
      ]
    },
    {
      "name": "slash_between_digits_agree",
      "description": "A '/' between two ASCII digits is part of the number (23/30), not a separator, on both sides.",
      "input": "23/30的人",
      "expected": [
        {
          "content": "23/30的人",
          "punctuation": "",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        }
      ]
    },
    {
      "name": "slash_between_words_agree",
      "description": "A '/' between words is Po punctuation and splits on both sides.",
      "input": "他/她",
      "expected": [
        {
          "content": "他",
          "punctuation": "/",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "她",
          "punctuation": "",
          "startIndex": 2,
          "lineBreaks": "",
          "startedBy": "/"
        }
      ]
    },
    {
      "name": "slash_digit_then_word_agree",
      "description": "Only a digit on BOTH sides keeps the '/' in the content: a digit before and a word after still splits.",
      "input": "3/月",
      "expected": [
        {
          "content": "3",
          "punctuation": "/",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "月",
          "punctuation": "",
          "startIndex": 2,
          "lineBreaks": "",
          "startedBy": "/"
        }
      ]
    },
    {
      "name": "ellipsis_agree",
      "description": "Po on both sides.",
      "input": "他…好",
      "expected": [
        {
          "content": "他",
          "punctuation": "…",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 2,
          "lineBreaks": "",
          "startedBy": "…"
        }
      ]
    },
    {
      "name": "line_break_agree",
      "description": "A line break ends the chunk and starts the next with startedBy 'linebreak'.",
      "input": "line1\nline2",
      "expected": [
        {
          "content": "line1",
          "punctuation": "",
          "startIndex": 0,
          "lineBreaks": "\n",
          "startedBy": "start"
        },
        {
          "content": "line2",
          "punctuation": "",
          "startIndex": 6,
          "lineBreaks": "",
          "startedBy": "linebreak"
        }
      ]
    },
    {
      "name": "punctuation_after_line_break_agree",
      "description": "A punctuation-only chunk mid-text, after a line break.",
      "input": "你好\n《标题》内容",
      "expected": [
        {
          "content": "你好",
          "punctuation": "",
          "startIndex": 0,
          "lineBreaks": "\n",
          "startedBy": "start"
        },
        {
          "content": "",
          "punctuation": "《",
          "startIndex": null,
          "lineBreaks": "",
          "startedBy": "linebreak"
        },
        {
          "content": "标题",
          "punctuation": "》",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "《"
        },
        {
          "content": "内容",
          "punctuation": "",
          "startIndex": 7,
          "lineBreaks": "",
          "startedBy": "》"
        }
      ]
    },
    {
      "name": "leading_punctuation_pair_agree",
      "description": "Two leading punctuation characters merge onto one empty-content chunk.",
      "input": "《》你好",
      "expected": [
        {
          "content": "",
          "punctuation": "《》",
          "startIndex": null,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "你好",
          "punctuation": "",
          "startIndex": 2,
          "lineBreaks": "",
          "startedBy": "《》"
        }
      ]
    },
    {
      "name": "trailing_punctuation_after_line_break_agree",
      "description": "A punctuation-only chunk after a line break, with no content after it.",
      "input": "你好\n。",
      "expected": [
        {
          "content": "你好",
          "punctuation": "",
          "startIndex": 0,
          "lineBreaks": "\n",
          "startedBy": "start"
        },
        {
          "content": "",
          "punctuation": "。",
          "startIndex": null,
          "lineBreaks": "",
          "startedBy": "linebreak"
        }
      ]
    },
    {
      "name": "blank_line_agree",
      "description": "Two line breaks stay together on one chunk.",
      "input": "第一行\n\n第二行",
      "expected": [
        {
          "content": "第一行",
          "punctuation": "",
          "startIndex": 0,
          "lineBreaks": "\n\n",
          "startedBy": "start"
        },
        {
          "content": "第二行",
          "punctuation": "",
          "startIndex": 5,
          "lineBreaks": "",
          "startedBy": "linebreak"
        }
      ]
    },
    {
      "name": "leading_punctuation_agree",
      "description": "Leading punctuation yields an empty-content chunk startedBy 'start'.",
      "input": "《标题》内容",
      "expected": [
        {
          "content": "",
          "punctuation": "《",
          "startIndex": null,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "标题",
          "punctuation": "》",
          "startIndex": 1,
          "lineBreaks": "",
          "startedBy": "《"
        },
        {
          "content": "内容",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "》"
        }
      ]
    },
    {
      "name": "punctuation_then_line_break_agree",
      "description": "Punctuation then a line break.",
      "input": "你好，\n世界",
      "expected": [
        {
          "content": "你好",
          "punctuation": "，",
          "startIndex": 0,
          "lineBreaks": "\n",
          "startedBy": "start"
        },
        {
          "content": "世界",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "linebreak"
        }
      ]
    },
    {
      "name": "whitespace_only_agree",
      "description": "Whitespace-only input gives no chunks.",
      "input": "   ",
      "expected": []
    },
    {
      "name": "astral_char_start_index_is_utf16_agree",
      "description": "startIndex counts UTF-16 code units (an astral character is 2), so it indexes the JS string directly.",
      "input": "𠮷你，世界",
      "expected": [
        {
          "content": "𠮷你",
          "punctuation": "，",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "世界",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "，"
        }
      ]
    },
    {
      "name": "indent_after_line_break_agree",
      "description": "A paragraph indent after a line break is not part of the chunk: startIndex is the first character of content.",
      "input": "你好。\n　　他说话了，然后走了。",
      "expected": [
        {
          "content": "你好",
          "punctuation": "。",
          "startIndex": 0,
          "lineBreaks": "\n",
          "startedBy": "start"
        },
        {
          "content": "他说话了",
          "punctuation": "，",
          "startIndex": 6,
          "lineBreaks": "",
          "startedBy": "linebreak"
        },
        {
          "content": "然后走了",
          "punctuation": "。",
          "startIndex": 11,
          "lineBreaks": "",
          "startedBy": "，"
        }
      ]
    },
    {
      "name": "leading_spaces_agree",
      "description": "Leading spaces are skipped by startIndex, like the trim skips them in content.",
      "input": "  你好，世界",
      "expected": [
        {
          "content": "你好",
          "punctuation": "，",
          "startIndex": 2,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "世界",
          "punctuation": "",
          "startIndex": 5,
          "lineBreaks": "",
          "startedBy": "，"
        }
      ]
    },
    {
      "name": "spaces_after_colon_agree",
      "description": "Spaces after punctuation that opens a chunk are skipped by startIndex.",
      "input": "他说：  你好",
      "expected": [
        {
          "content": "他说",
          "punctuation": "：",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "你好",
          "punctuation": "",
          "startIndex": 5,
          "lineBreaks": "",
          "startedBy": "："
        }
      ]
    }
  ]
}
