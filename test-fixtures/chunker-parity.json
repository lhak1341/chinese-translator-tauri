          "startedBy": "start"
        },
        {
          "content": "标题",
          "punctuation": "》",
          "startIndex": 1,
          "lineBreaks": "",
          "startedBy": "《"
        },
        {
          "content": "内容",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "》"
