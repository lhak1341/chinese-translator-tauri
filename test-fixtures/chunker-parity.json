    {
      "name": "leading_punctuation_start_index",
      "description": "Leading punctuation yields an empty-content chunk startedBy 'start'. Rust reports its startIndex as 1 (the index of the content that flushed it), JS as 0; every other field agrees.",
      "input": "《标题》内容",
      "expectAgreement": false,
      "rust": [
        {
          "content": "",
          "punctuation": "《",
          "startIndex": 1,
