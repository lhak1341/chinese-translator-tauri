{
  "_contract": "Shared cross-language chunker fixture (architecture review 2026-10-03, candidate #3 grilling). Both wasm-core/src/text_chunker.rs (mod tests::parity) and src/utils/__tests__/TextChunker.parity.test.js read this file and assert their own real chunker's output against it, for the cases where they agree and the cases where they are documented to diverge. WASM is the live path; the JS chunker runs only when WASM is not ready, failed to init, or was retired after a panic, so any remaining divergence here means the same text can chunk differently within one session. Do not edit a rust/js expectation to make a test pass: change the chunker, or record the divergence on purpose.",
  "cases": [
    {
      "name": "comma_and_period_agree",
      "description": "Ordinary Chinese sentence punctuation splits on both sides.",
      "input": "你好，世界。",
      "expectAgreement": true,
      "rust": [
        {
          "content": "你好",
          "punctuation": "，",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "世界",
          "punctuation": "。",
          "startIndex": 3,
          "lineBreaks": "",
          "startedBy": "，"
        }
      ],
      "js": [
        {
          "content": "你好",
          "punctuation": "，",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "世界",
          "punctuation": "。",
          "startIndex": 3,
          "lineBreaks": "",
          "startedBy": "，"
        }
      ]
    },
    {
      "name": "stacked_quote_punctuation_agree",
      "description": "Consecutive punctuation merges onto the preceding chunk.",
      "input": "他说：「好」",
      "expectAgreement": true,
      "rust": [
        {
          "content": "他说",
          "punctuation": "：「",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "」",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "：「"
        }
      ],
      "js": [
        {
          "content": "他说",
          "punctuation": "：「",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "」",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "：「"
        }
      ]
    },
    {
      "name": "hyphen_agree",
      "description": "Pd (dash punctuation): Both sides split on it (the JS detector enabled Pd and Pc on 2026-10-03 to match Rust, which is what ships).",
      "input": "他说-好",
      "expectAgreement": true,
      "rust": [
        {
          "content": "他说",
          "punctuation": "-",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 3,
          "lineBreaks": "",
          "startedBy": "-"
        }
      ],
      "js": [
        {
          "content": "他说",
          "punctuation": "-",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 3,
          "lineBreaks": "",
          "startedBy": "-"
        }
      ]
    },
    {
      "name": "em_dash_pair_agree",
      "description": "The Chinese two-em dash (——) used for breaks in dialogue; Pd, so the same as the hyphen.",
      "input": "他说——好",
      "expectAgreement": true,
      "rust": [
        {
          "content": "他说",
          "punctuation": "——",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "——"
        }
      ],
      "js": [
        {
          "content": "他说",
          "punctuation": "——",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
          "punctuation": "",
          "startIndex": 4,
          "lineBreaks": "",
          "startedBy": "——"
        }
      ]
    },
    {
      "name": "underscore_agree",
      "description": "Pc (connector punctuation): Both sides split on it (the JS detector enabled Pc on 2026-10-03 to match Rust).",
      "input": "他_好",
      "expectAgreement": true,
      "rust": [
        {
          "content": "他",
          "punctuation": "_",
          "startIndex": 0,
          "lineBreaks": "",
          "startedBy": "start"
        },
        {
          "content": "好",
