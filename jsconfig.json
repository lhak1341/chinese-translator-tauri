{
  "compilerOptions": {
    // Enable type checking on JavaScript files (respects JSDoc)
    "checkJs": true,

    // JSX support for React
    "jsx": "react-jsx",

    // Module system
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Target modern JavaScript
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // Strict type checking (lenient for now)
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,

    // Allow JavaScript files
    "allowJs": true,
    "skipLibCheck": true,

    // Path resolution
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    // Better error messages
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,

    // Enable all strict options gradually (commented out for now)
    // "strictNullChecks": true,
    // "noImplicitAny": true,
    // "strictPropertyInitialization": true
  },
  "include": [
    "src/**/*",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "wasm-core/target",
    "scripts"
  ]
}
