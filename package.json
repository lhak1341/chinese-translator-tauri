{
  "name": "chinese-translator-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run build-wasm-dev && vite",
    "build": "bun run build-wasm && tsc && vite build",
    "build-wasm": "cd wasm-core && wasm-pack build --target web --out-dir ../src/wasm",
    "build-wasm-dev": "cd wasm-core && wasm-pack build --dev --target web --out-dir ../src/wasm",
    "test": "node scripts/ensure-wasm-fresh.mjs && vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "node scripts/ensure-wasm-fresh.mjs && vitest --coverage",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:full": "eslint .",
    "type-check": "tsc --noEmit",
    "check": "bun run type-check",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "deploy": "bash scripts/install-app.sh && bun run sweep-targets",
    "sweep-targets": "cargo sweep --time 7 src-tauri && cargo sweep --time 7 wasm-core",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node scripts/lint-ratchet.mjs --update",
    "lint:ratchet-down": "node scripts/lint-ratchet.mjs --ratchet-down"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@lhak/style": "file:./vendor/lhak-style",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'"
    ]
  }
}
